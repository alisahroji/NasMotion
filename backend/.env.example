# ══════════════════════════════════════════════════════════════
#  NasMotion Backend — Environment Template
#  Salin jadi .env lalu isi nilai aslinya. JANGAN commit .env asli.
# ══════════════════════════════════════════════════════════════

# ─── Server ──────────────────────────────────────────────────
# Port untuk menjalankan API secara lokal.
# Catatan: di Vercel, PORT di-set otomatis oleh platform.
PORT=5000
NODE_ENV=development

# ─── Database (Supabase PostgreSQL) ──────────────────────────
# Ambil dari: Supabase Dashboard → Project → Connect → Connection string.
#
# Untuk Vercel/serverless gunakan "Connection pooling" (port 6543).
# Untuk migrasi/seed lokal gunakan "Direct connection" (port 5432).
#
# Format (pooler):
#   postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
#
# PENTING (hasil audit STEP 1):
#   - Username WAJIB berformat postgres.<PROJECT_REF> (bukan postgres saja).
#   - <PROJECT_REF> harus 20 karakter & cocok dengan project Supabase aktif.
#   - Error "tenant/user ... not found" artinya project ref tidak dikenal
#     pooler (project paused/deleted/ref salah) — bukan masalah SSL/kode.
DATABASE_URL=your_supabase_postgresql_connection_string

# ─── Supabase API (opsional) ─────────────────────────────────
# Hanya dipakai src/config/supabase.js (belum direquire oleh app).
# HARUS URL API project (https://<PROJECT_REF>.supabase.co),
# BUKAN link dashboard (https://supabase.com/dashboard/project/...).
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── Auth (JWT) ──────────────────────────────────────────────
# Secret kuat & acak, minimal 32 karakter.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_strong_random_secret_min_32_chars
JWT_EXPIRES_IN=8h

# ─── CORS ────────────────────────────────────────────────────
# Origin frontend yang diizinkan mengirim cookie.
# Produksi: isi dengan URL frontend (contoh: https://nasmotion-frontend.vercel.app)
CLIENT_URL=http://localhost:3000
